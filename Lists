print(ffruits)   #changing lists


basket = ["banana", "orange","mango","lemon"]
#append inserts an item at the end
basket.append("apple")
print(basket)
#insert adds an item at a specified index
basket.insert(2, "kiwi")
print(basket)
#remove we remove a specified item
basket.remove("orange")
# pop - removes items from specified index
basket.pop(0)
print(basket)


#copying
basket_copy = basket.copy()
print(basket_copy)
#joining
