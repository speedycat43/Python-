'''A tuple is a collection that is ordered and unchangeable
tuples are written in round bracket'''
empty_tuple = ()
fruits = ( "banana", "orange", "mango", "lemon")
print(fruits[2])
print(fruits[-2])
#slicing
all_fruits = fruits[0:4] #prints all fruits
orange_mango = fruits [1:3]
print(fruits[-3:-1])
#reverse tupple 
fruits[::-1]
print(fruits[::-1])
# changing tuples into lists
fruits = list(fruits)
fruits[0] = "apple"
print(fruits)
#checking item in tuple
fruits = ( "banana", "orange", "mango", "lemon")
print("orange" in fruits) #true
print("apple" in fruits) #false
#joining two tupples
vegetables = ("tomato", "potato", "onion", "carrot")
fruits_and_vegetables = fruits + vegetables
print(fruits_and_vegetables)
#deleting tupple
del fruits 
