''' STRING METHODS'''
#capitalize()
a = "meow"
print(a.capitalize()) # first character becomes capital
#count returns occurences of a substring in a string
challenge = "thirty days of python"
print(challenge.count("y"))
#endswith() startswith()
print(challenge.endswith("on")) #returns true
print(challenge.endswith("si")) #returns false
print(challenge.startswith("thirty")) #returns true
#find() : returns first occurance of a character
print(challenge.find("y"))
#rfind() : returns index of the last occurance of a character
print(challenge.rfind("y"))

challenge = "thirty days of python "
sub_string = "da"
#index() returns the lowest index of a substring
print(challenge.index(sub_string))
#rindex() returns the highest index of a substring
print(challenge.rindex(sub_string))

#replace
data = "apple tree"
print(data.replace("apple" , "banana"))

#split
print(challenge.split())
