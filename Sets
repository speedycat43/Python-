'''Sets is a collection of data
it is unindexed and unordered
there is no repetation of elements'''
empty_set = set()
fruits = {'banana', 'orange', 'mango', 'lemon'}
#checking an item
print("orange" in fruits) #true
#add
fruits.add("lime")
print(fruits) 
vegetables = ("tomato", "potato", "onion" )
fruits.update(vegetables)
#remove
fruits.pop() 
print(fruits)
#convert list to set
fruits = ["banana", "orange", "mango", "apple" ]
fruits = set(fruits)
print(fruits)
#joining sets
fruits = {'banana', 'orange', 'mango', 'lemon'}
vegetables = {'tomato', 'potato', 'cabbage','onion', 'carrot'}
print(fruits.union(vegetables))
print(fruits.update(vegetables))
#intersection
whole_num = {0,1,2,3,4,5,6}
even_num = {2,4,6}
print(whole_num.intersection(even_num))
